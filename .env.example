# Copy to .env (make dev does this for you). Local-dev values only; never commit real secrets.
ANTHROPIC_API_KEY=
LLM_MODEL_SMART=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5
DATABASE_URL=postgresql+psycopg://stylecut:stylecut@postgres:5432/stylecut
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
# Endpoint the browser uses for presigned uploads/downloads (S3_ENDPOINT is the in-cluster one).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=stylecut
# MinIO's public default credentials, valid only for the local docker-compose MinIO.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
ENABLE_URL_INGEST=true
# "small" for CPU-only machines (Apple Silicon); use large-v3 on GPU workers.
WHISPER_MODEL=small
DEV_USER_ID=00000000-0000-0000-0000-000000000001
# Exposes POST /api/v1/dev/demo-job for exercising the job pipeline. Keep false outside local dev.
ENABLE_DEV_ROUTES=true
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
