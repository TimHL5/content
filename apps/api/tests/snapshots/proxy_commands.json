{
  "proxy_with_audio": [
    "-i",
    "/in/a.mov",
    "-map",
    "0:v:0",
    "-vf",
    "scale=w='if(lt(iw,ih),min(540,iw),-2)':h='if(lt(iw,ih),-2,min(540,ih))',crop=trunc(iw/2)*2:trunc(ih/2)*2,fps=30,format=yuv420p,setsar=1",
    "-c:v",
    "libx264",
    "-preset",
    "veryfast",
    "-crf",
    "26",
    "-g",
    "30",
    "-fps_mode",
    "cfr",
    "-map",
    "0:a:0",
    "-c:a",
    "aac",
    "-ar",
    "48000",
    "-ac",
    "2",
    "-b:a",
    "128k",
    "-map_metadata",
    "-1",
    "-movflags",
    "+faststart",
    "/out/proxy.mp4"
  ],
  "proxy_silent": [
    "-i",
    "/in/a.mov",
    "-map",
    "0:v:0",
    "-vf",
